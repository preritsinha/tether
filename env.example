# Waysera relay configuration
# Copy to .env and adjust as needed.

# Comma-separated origins allowed to call /v1/health.
# WebSocket upgrades are not subject to CORS, and the relay uses no cookies
# or credentials, so this is a small surface.
ALLOWED_ORIGINS=http://localhost:3000

# Port the relay listens on. Render supplies this automatically in production.
PORT=8000
