<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground.

  Authored at 108dp with the artwork scaled into the central 72dp safe zone,
  because launchers mask this layer to arbitrary shapes (circle, squircle,
  teardrop) and anything outside that zone can be clipped away.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.05"
        android:scaleY="2.05"
        android:translateX="21.2"
        android:translateY="21.6">

        <!-- Three origins -->
        <path android:fillColor="#FFFFFF"
              android:pathData="M1.7,7.2 a2.9,2.9 0 1,0 5.8,0 a2.9,2.9 0 1,0 -5.8,0" />
        <path android:fillColor="#FFFFFF"
              android:pathData="M13.1,4.2 a2.9,2.9 0 1,0 5.8,0 a2.9,2.9 0 1,0 -5.8,0" />
        <path android:fillColor="#FFFFFF"
              android:pathData="M24.5,7.2 a2.9,2.9 0 1,0 5.8,0 a2.9,2.9 0 1,0 -5.8,0" />

        <!-- Converging routes -->
        <path android:strokeColor="#FFFFFF" android:strokeWidth="3.1"
              android:strokeLineCap="round"
              android:pathData="M5.2,10.2 C6.4,15.8 9.6,19.4 13.6,21.2" />
        <path android:strokeColor="#FFFFFF" android:strokeWidth="3.1"
              android:strokeLineCap="round"
              android:pathData="M16,7.4 L16,20.4" />
        <path android:strokeColor="#FFFFFF" android:strokeWidth="3.1"
              android:strokeLineCap="round"
              android:pathData="M26.8,10.2 C25.6,15.8 22.4,19.4 18.4,21.2" />

        <!-- Shared destination -->
        <path android:fillColor="#FFFFFF"
              android:pathData="M11.3,25 a4.7,4.7 0 1,0 9.4,0 a4.7,4.7 0 1,0 -9.4,0" />
    </group>
</vector>
